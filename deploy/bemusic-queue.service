[Unit]
Description=BeMusic queue worker (Horizon)
Documentation=https://laravel.com/docs/horizon
After=network.target mariadb.service redis-server.service
Wants=redis-server.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/bemusic
ExecStart=/usr/bin/php /var/www/bemusic/artisan horizon
Restart=always
RestartSec=5
KillSignal=SIGQUIT

# Lower process priority so web requests win on the cheap VM.
Nice=10

[Install]
WantedBy=multi-user.target