# BeMusic production configuration for a single free Azure VM (LEMP, no Docker)
# APP_URL and DB_PASSWORD are substituted by deploy/setup.sh. APP_KEY is
# generated on the server (php artisan key:generate).

APP_NAME=Keekii Music
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=__APP_URL__
APP_VERSION=3.1.8
APP_LOCALE=english
INSTALLED=false
BILLING_ENABLED=true
NOTIFICATIONS_ENABLED=true
NOTIF_SUBS_ENABLED=true
HIDE_DOCS_BUTTONS=false
DISABLE_UPDATE_AUTH=false
ENABLE_CONTACT_PAGE=true
API_INTEGRATED=true
CLOCKWORK_ENABLED=false
PULSE_ENABLED=false
ELASTICSEARCH_HOST=localhost:9200
SPOTIFY_USE_DEPRECATED_API=false
SERVICE_WORKER_INTEGRATED=true

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bemusic
DB_USERNAME=bemusic
DB_PASSWORD=__DB_PASSWORD__
DB_PREFIX=null
DB_STRICT_MODE=false

# Redis is installed natively on the VM; kept as the cache/session/queue engine.
# Reverb (websockets) is disabled intentionally: BROADCAST_CONNECTION=log keeps
# the app on free infra without needing a separate websocket process.
BROADCAST_CONNECTION=log
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Full-text search runs on a local Meilisearch service (installed by setup.sh).
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=__MEILISEARCH_KEY__
SCOUT_MYSQL_MODE=extended
SCOUT_QUEUE=true

# Mail: Gmail SMTP (configure via admin UI or set here)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=__MAIL_USERNAME__
MAIL_PASSWORD=__MAIL_PASSWORD__
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=__MAIL_FROM_ADDRESS__
MAIL_FROM_NAME=__MAIL_FROM_NAME__

GOOGLE_ID=null
GOOGLE_SECRET=null

TWITTER_ID=null
TWITTER_SECRET=null

FACEBOOK_ID=null
FACEBOOK_SECRET=null

LASTFM_API_KEY=3aabc0162ce43b2f1cb78c617ce73fd3

SPOTIFY_ID=5371cec62b4644de94470eeaf6958669
SPOTIFY_SECRET=6121a025b8034c5c90afb99f37164035

PAYPAL_PRODUCT_ID=b808bbf3-7372-4e57-b6fd-7672a546bd61
PAYPAL_PRODUCT_NAME="Keekii Music Subscription"

REMOTE_FILE_VISIBILITY=private
USE_PRESIGNED_S3_URLS=true
STATIC_FILE_DELIVERY=xaccel
UPLOADS_DISK_DRIVER=local
PUBLIC_DISK_DRIVER=local

# Optional: SES / Postmark / Resend (configure via admin UI)
# AWS_ACCESS_KEY_ID=__AWS_ACCESS_KEY_ID__
# AWS_SECRET_ACCESS_KEY=__AWS_SECRET_ACCESS_KEY__
# AWS_DEFAULT_REGION=us-east-1
# POSTMARK_TOKEN=__POSTMARK_TOKEN__
# RESEND_KEY=__RESEND_KEY__

